{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": false,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "paths": {
      "@workspace/ui/*": ["./src/*"]
    }
  },
  "include": ["src", ".storybook/*.ts", ".storybook/*.tsx", "vitest.*.ts"],
  "exclude": ["node_modules", "storybook-static"]
}
